---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const categoryLabel: Record<string, string> = {
  art: 'Art',
  essay: 'Essay',
  other: 'Other',
};

const tabs = [
  { key: 'all', label: 'All' },
  { key: 'art', label: 'Art' },
  { key: 'essay', label: 'Essay' },
  { key: 'other', label: 'Other' },
];
---

<BaseLayout title="Projects" description="A collection of Art, essays, and other work Yein has made at school">
  <section class="wrap page-head">
    <p class="eyebrow">Portfolio</p>
    <h1>Projects</h1>
    <p class="page-lede">A collection of Art, essays, and other work from school.</p>
  </section>

  <section class="wrap">
    <div class="filter-tabs" id="filter-tabs">
      {tabs.map((tab) => (
        <a href="#" data-filter={tab.key} aria-current={tab.key === 'all' ? 'page' : undefined}>
          {tab.label}
        </a>
      ))}
    </div>

    {posts.length > 0 ? (
      <div class="card-grid" id="post-grid">
        {posts.map((post) => (
          <a class="card" href={`/projects/${post.slug}/`} data-category={post.data.category}>
            <div class="card-cover">
              {post.data.cover && <img src={post.data.cover} alt={post.data.title} />}
            </div>
            <div class="card-body">
              <span class="card-tag">{categoryLabel[post.data.category]}</span>
              <h3 class="card-title">{post.data.title}</h3>
              <p class="card-summary">{post.data.summary}</p>
              <span class="card-date">{post.data.date.toLocaleDateString('en-US')}</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-state">No projects yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 48px 24px 28px;
  }
  .page-lede {
    color: var(--ink-soft);
    margin: 8px 0 0;
  }
</style>

<script>
  const tabsEl = document.getElementById('filter-tabs');
  const gridEl = document.getElementById('post-grid');

  tabsEl?.addEventListener('click', (event) => {
    const target = (event.target as HTMLElement).closest('a[data-filter]');
    if (!target) return;
    event.preventDefault();

    const filter = target.getAttribute('data-filter');

    tabsEl.querySelectorAll('a').forEach((a) => a.removeAttribute('aria-current'));
    target.setAttribute('aria-current', 'page');

    gridEl?.querySelectorAll<HTMLElement>('[data-category]').forEach((card) => {
      const matches = filter === 'all' || card.dataset.category === filter;
      card.style.display = matches ? '' : 'none';
    });
  });
</script>

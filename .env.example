# Azure OpenAI 설정
# 이 파일을 .env로 복사한 후 실제 값으로 교체하세요
# Azure ML에서는 Environment Variables 또는 Key Vault를 사용하세요

# Azure OpenAI 엔드포인트 (필수)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure OpenAI API Key
# Managed Identity 사용 시: 이 항목을 비워두면 자동으로 Managed Identity 사용
# 로컬 개발 또는 명시적 키 사용 시: 실제 키 입력
AZURE_OPENAI_API_KEY=your-api-key-here

# Azure OpenAI 모델 배포 이름 (Azure Portal에서 확인)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure OpenAI API 버전
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI 설정
# 이 파일을 .env로 복사한 후 실제 값으로 교체하세요
# Azure ML에서는 Environment Variables 또는 Key Vault를 사용하세요

# Azure OpenAI 엔드포인트 (필수)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure OpenAI API Key
# Managed Identity 사용 시: 이 항목을 비워두면 자동으로 Managed Identity 사용
# 로컬 개발 또는 명시적 키 사용 시: 실제 키 입력
AZURE_OPENAI_API_KEY=your-api-key-here

# Azure OpenAI 모델 배포 이름 (Azure Portal에서 확인)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# Azure OpenAI API 버전
AZURE_OPENAI_API_VERSION=2024-02-01

# -----------------------------------------------------------------------
# 웹 검색 API 설정 (web_search_plugin.py)
# 우선순위: Bing > SerpAPI > DuckDuckGo(무료 fallback, 자동 사용)
# -----------------------------------------------------------------------

# [옵션 1] Bing Web Search API v7 (권장 - Azure 네이티브)
# 발급 방법:
#   Azure Portal > 리소스 만들기 > "Bing Search v7" 검색 > 만들기
#   생성 후: 리소스 > 키 및 엔드포인트 > KEY1 복사
# 가격: 월 1,000건 무료 / 초과 시 $3/1000건 (S1 기준)
BING_SEARCH_API_KEY=

# [옵션 2] SerpAPI (Google 검색 결과 제공)
# 발급 방법: https://serpapi.com/manage-api-key 에서 가입 후 발급
# 가격: 월 100건 무료 / 초과 시 유료 플랜 필요
SERPAPI_API_KEY=

# 참고: 위 두 키가 모두 비어 있으면 DuckDuckGo Instant Answer API (무료)를
#       자동으로 사용합니다. 결과 품질은 Bing/SerpAPI 대비 제한적입니다.

# -----------------------------------------------------------------------
# 석유화학 BI Agent 설정 (06_petrochem_bi_agent.py)
# -----------------------------------------------------------------------

# 보고서 출력 디렉토리 (기본값: semantic_kernel_agent/output/reports)
PETROCHEM_OUTPUT_DIR=output/reports

# 가격 캐시 디렉토리 (기본값: semantic_kernel_agent/data/price_cache)
PETROCHEM_PRICE_CACHE_DIR=data/price_cache

# [Phase 1.5] S&P Global Commodity Insights (Platts) API
# 발급: https://developer.spglobal.com/
SPGLOBAL_API_KEY=

# [Phase 1.5] ICIS Data API
# 발급: https://www.icis.com/explore/contact/request-a-demo/
ICIS_API_KEY=

# [선택] Azure Blob Storage - 보고서 업로드용
# 발급: Azure Portal > Storage Account > 액세스 키 > 연결 문자열
AZURE_STORAGE_CONNECTION_STRING=
